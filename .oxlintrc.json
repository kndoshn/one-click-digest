{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": ["src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/background/**"],
                "message": "Content scripts run in web pages: keep API calls and the API key in the background worker."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        // Tests are untyped JavaScript, so these type-aware rules only see `any`.
        "typescript/no-base-to-string": "off",
        "typescript/no-implied-eval": "off",
        "typescript/require-array-sort-compare": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        // Playwright fixtures without dependencies must still destructure their first argument.
        "no-empty-pattern": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "build/**", "coverage/**", "third_party/**", "test-results/**", "playwright-report/**"]
}
