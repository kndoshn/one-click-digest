{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "none",
  "ignorePatterns": [
    "third_party/**",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "package.json",
    "package-lock.json",
    "public/manifest.json",
    ".release-please-manifest.json"
  ]
}
