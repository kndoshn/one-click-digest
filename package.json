{
  "name": "one-click-digest",
  "version": "1.1.1",
  "description": "Chrome extension that summarizes web articles with one click using your Claude API key",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/build.mjs --test && node --test",
    "test:coverage": "node scripts/build.mjs --test && c8 node --test",
    "test:coverage:report": "npm run test:coverage && c8 report --reporter=html",
    "test:e2e": "npm run build:e2e && playwright test",
    "eval": "node eval/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kndoshn/one-click-digest.git"
  },
  "bugs": {
    "url": "https://github.com/kndoshn/one-click-digest/issues"
  },
  "homepage": "https://github.com/kndoshn/one-click-digest#readme",
  "keywords": [
    "chrome-extension",
    "claude",
    "ai",
    "summarizer",
    "article"
  ],
  "author": "kndoshn",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "valibot": "^1.5.0"
  }
}
