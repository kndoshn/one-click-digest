{
  "name": "one-click-digest",
  "version": "1.0.7",
  "description": "Chrome extension that summarizes web articles with one click using your Claude API key",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && c8 node --test",
    "test:coverage:report": "npm run test:coverage && c8 report --reporter=html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kndoshn/one-click-digest.git"
  },
  "bugs": {
    "url": "https://github.com/kndoshn/one-click-digest/issues"
  },
  "homepage": "https://github.com/kndoshn/one-click-digest#readme",
  "keywords": [
    "chrome-extension",
    "claude",
    "ai",
    "summarizer",
    "article"
  ],
  "author": "kndoshn",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "c8": "^12.0.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
